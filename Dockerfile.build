FROM clux/muslrust:stable

# Install build tools needed for bundled libpq compilation
# The pq-sys crate with "bundled" feature will compile PostgreSQL from source
# which requires make, perl, and other build tools
RUN apt-get update && \
    apt-get install -y \
    make \
    perl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for static linking
ENV PKG_CONFIG_ALLOW_CROSS=1

# Copy source code
COPY --chown=rust:rust . .

# Extra arguments to pass to cargo.
ENV CARGO_ARGS=

# Build all binaries.
CMD if [ -d target ]; then chown -R rust:rust /volume/.cargo/git /volume/.cargo/registry /volume/target; fi && \
    cargo build --all ${CARGO_ARGS} --target x86_64-unknown-linux-musl && \
    cd guide && mdbook build
