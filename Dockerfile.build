FROM clux/muslrust:stable

# Install PostgreSQL development libraries (needed for diesel with postgres feature)
# We need both the regular dev package and the static libraries for musl linking
RUN apt-get update && \
    apt-get install -y \
    libpq-dev \
    postgresql-server-dev-all \
    libkrb5-dev \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables to help pkg-config find the static libraries
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV PQ_LIB_STATIC=1

# Copy source code
COPY --chown=rust:rust . .

# Extra arguments to pass to cargo.
ENV CARGO_ARGS=

# Build all binaries.
CMD if [ -d target ]; then chown -R rust:rust /volume/.cargo/git /volume/.cargo/registry /volume/target; fi && \
    cargo build --all ${CARGO_ARGS} --target x86_64-unknown-linux-musl && \
    cd guide && mdbook build
