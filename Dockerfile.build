FROM rust:1.85

# Install PostgreSQL development libraries (for dynamic linking)
RUN apt-get update && \
    apt-get install -y \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install mdbook for building the guide
RUN cargo install mdbook

WORKDIR /volume

# Copy source code
COPY . .

# Extra arguments to pass to cargo.
ENV CARGO_ARGS=

# Build all binaries (dynamically linked for x86_64-unknown-linux-gnu)
CMD cargo build --all ${CARGO_ARGS} && \
    cd guide && mdbook build
